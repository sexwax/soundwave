# Cloudflare Worker (or similar) that proxies radio streams blocked by CORS.
# Optional: leave empty to skip the proxy and try direct URLs only.
# See the "Proxy CORS" section in README.md for a ready-to-deploy Worker.
VITE_CORS_PROXY_URL=
# Base URL for share links / Open Graph tags. Optional: leave empty to fall
# back to window.location.origin at runtime.
VITE_APP_URL=
